      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
    <ProjectReference Include="..\..\main\R3EventsGenerator.Attributes\R3EventsGenerator.Attributes.csproj" />
  </ItemGroup>

</Project>
